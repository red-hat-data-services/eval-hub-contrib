# LightEval adapter container for eval-hub (rhoai-3.6 downstream)
#
# AIPCC base: ships Python 3.12 at /opt/app-root and openmpi, which the
# curated RHEL torch wheels link against (libmpi_cxx.so.40). Plain
# ubi9/python-312 installs the same wheel set but cannot import torch.
# The digest pin below is what Renovate keeps updated.
ARG BASE_IMAGE=quay.io/aipcc/base-images/cpu-el9.8:3.6.0-ea.2@sha256:5dbe6a3e14877ef9fbda55e6cef66430a244c6a5c73a9a72bfef5b3af31e44c5
FROM ${BASE_IMAGE}
ARG BASE_IMAGE

# The base runs as uid 1001 (default); root is only needed for chowns.
USER 0

# Set working directory
WORKDIR /app

# Copy the lockfile and install Python dependencies.
# requirements-rhoai.txt is uv-compiled from requirements.txt plus
# requirements-overrides.txt against the RHOAI curated index (its
# --index-url is embedded in the file); under hermetic Konflux builds,
# Hermeto's prefetched wheels are used instead via --no-index.
COPY requirements-rhoai.txt .
RUN pip install --no-cache-dir -r requirements-rhoai.txt

# uv is build tooling inherited from the base image, not a runtime dependency.
RUN /opt/app-root/bin/python -m pip uninstall -y uv && \
    test ! -e /opt/app-root/bin/uv && \
    test ! -e /opt/app-root/bin/uvx

# Copy adapter implementation
COPY main.py .

# Create writable cache directories with proper permissions
# Make site-packages writable for lighteval to cache task data
RUN mkdir -p /tmp/.litellm_cache && \
    chmod -R 777 /tmp && \
    chown -R 1001:0 /app && \
    chmod -R g+rwX /app && \
    chown -R 1001:0 /opt/app-root && \
    chmod -R g+rwX /opt/app-root

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV EVALHUB_MODE=k8s
ENV HOME=/tmp
ENV LITELLM_CACHE_DIR=/tmp/.litellm_cache

# Switch back to non-root user
USER 1001

# Run the adapter
ENTRYPOINT ["python", "main.py"]

LABEL com.redhat.component="odh-eval-hub-lighteval-rhel9" \
      name="rhoai/odh-eval-hub-lighteval-rhel9" \
      description="LightEval framework adapter for eval-hub" \
      summary="odh-eval-hub-lighteval" \
      maintainer="['managed-open-data-hub@redhat.com']" \
      io.openshift.expose-services="" \
      io.k8s.display-name="odh-eval-hub-lighteval" \
      io.k8s.description="LightEval framework adapter for eval-hub" \
      com.redhat.license_terms="https://www.redhat.com/licenses/Red_Hat_Standard_EULA_20191108.pdf" \
      com.redhat.aiplatform.image="${BASE_IMAGE}"
