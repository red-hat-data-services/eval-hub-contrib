# promptfoo adapter image — Konflux/RHOAI build (digest-pinned).
#
# Uses ubi-minimal so we can enable the nodejs:24 AppStream module. The
# ubi9/python-* images already enable nodejs:22, and switching streams fails
# with "It is not possible to switch enabled streams of a module".
#
# Keep the build body in sync with Containerfile; the intentional deltas are
# the digest-pinned BASE_IMAGE default (RHOAI 9.8 / PQC channel) and the
# component LABEL block below.

ARG BASE_IMAGE=registry.redhat.io/ubi9/ubi-minimal-pqc:9.8@sha256:d638f3b49b79575329aacdae2739f954effe2467c12147711e73445c4fc97819
FROM ${BASE_IMAGE}
ARG BASE_IMAGE

# Keep in sync with main.py PROMPTFOO_VERSION.
ARG PROMPTFOO_VERSION=0.123.1

WORKDIR /app

USER 0

# Strip unused native/tooling binaries that fail check-payload (static
# esbuild, OpenAI Codex musl binaries, Playwright cache, Claude agent
# SDK). EvalHub only needs the promptfoo CLI for eval/redteam; these
# transitive packages are not invoked by adapters/promptfoo/main.py.
#
# PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 stops Chromium/ffmpeg from being
# fetched during npm install. Also rm both /root and common cache
# paths in case a prior layer or postinstall still wrote them.
RUN microdnf -y module enable nodejs:24 \
    && microdnf -y install \
        nodejs \
        python3.12 \
        python3.12-pip \
        shadow-utils \
    && microdnf clean all \
    && ln -sf /usr/bin/python3.12 /usr/bin/python \
    && PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 npm install -g "promptfoo@${PROMPTFOO_VERSION}" \
    && npm cache clean --force \
    && rm -rf \
        /root/.cache/ms-playwright \
        /opt/app-root/src/.cache/ms-playwright \
        /usr/local/lib/node_modules/promptfoo/node_modules/@esbuild \
        /usr/local/lib/node_modules/promptfoo/node_modules/esbuild \
        /usr/local/lib/node_modules/promptfoo/node_modules/@openai/codex-linux-* \
        /usr/local/lib/node_modules/promptfoo/node_modules/@openai/codex-security \
        /usr/local/lib/node_modules/promptfoo/node_modules/@anthropic-ai/claude-agent-sdk-linux-* \
    && useradd -u 1001 -g 0 -M -d /app -s /sbin/nologin default

COPY requirements.txt .
RUN python -m pip install --no-cache-dir -r requirements.txt

COPY main.py .

RUN chown -R 1001:0 /app && chmod -R g+w /app

ENV PYTHONUNBUFFERED=1 \
    EVALHUB_MODE=k8s \
    PROMPTFOO_DISABLE_TELEMETRY=1

USER 1001

ENTRYPOINT ["python", "main.py"]

LABEL com.redhat.component="odh-eval-hub-promptfoo-rhel9" \
      name="rhoai/odh-eval-hub-promptfoo-rhel9" \
      description="promptfoo framework adapter for eval-hub" \
      summary="odh-eval-hub-promptfoo" \
      maintainer="['managed-open-data-hub@redhat.com']" \
      io.openshift.expose-services="" \
      io.k8s.display-name="odh-eval-hub-promptfoo" \
      io.k8s.description="promptfoo framework adapter for eval-hub" \
      com.redhat.license_terms="https://www.redhat.com/licenses/Red_Hat_Standard_EULA_20191108.pdf" \
      com.redhat.aiplatform.image="${BASE_IMAGE}"
